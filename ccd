def load_claude_sessions() -> list[RawClaudeSession]:
    sessions: dict[str, RawClaudeSession] = {}
    if CLAUDE_HISTORY_PATH.exists():
        with CLAUDE_HISTORY_PATH.open("r", encoding="utf-8") as f:
            for line in f:
                try:
                    item = json.loads(line)
                except json.JSONDecodeError:
                    continue
                sid = item.get("sessionId")
                if not sid:
                    continue
                title = user_visible_conversation_text(item.get("display")) or "(untitled)"
                sessions[sid] = RawClaudeSession(id=sid, title=title, updated_at=timestamp_to_iso(item.get("timestamp")), cwd=item.get("project"))

    if CLAUDE_PROJECTS_DIR.exists():
        for path in CLAUDE_PROJECTS_DIR.glob("**/*.jsonl"):
            sid = None
            title = None
            cwd = None
            timestamp = None
            try:
                stat_time = datetime.fromtimestamp(path.stat().st_mtime, timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
            except OSError:
                stat_time = None
            try:
                with path.open("r", encoding="utf-8") as f:
                    for idx, line in enumerate(f):
                        if idx > 250 and sid:
                            break
                        try:
                            item = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        sid = item.get("sessionId") or sid
                        cwd = item.get("cwd") or cwd
                        timestamp = item.get("timestamp") or timestamp
                        if not title and item.get("type") == "user" and not item.get("isMeta"):
                            text = user_visible_conversation_text(extract_claude_message_text(item.get("message")))
                            title = text[:80] if text else title
            except OSError:
                continue
            if not sid:
                match = re.search(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", path.name)
                sid = match.group(1) if match else None
            if not sid:
                continue
            existing = sessions.get(sid)
            if existing:
                existing.cwd = existing.cwd or cwd
                existing.transcript_path = existing.transcript_path or str(path)
                existing.updated_at = timestamp_to_iso(timestamp) or existing.updated_at or stat_time
                if existing.title == "(untitled)" and title:
                    existing.title = title
            else:
                sessions[sid] = RawClaudeSession(
                    id=sid,
                    title=title or "(untitled)",
                    updated_at=timestamp_to_iso(timestamp) or stat_time,
                    cwd=cwd,
                    transcript_path=str(path),
                )
    return sorted(sessions.values(), key=lambda s: sort_key_time(s.updated_at), reverse=True)


def choose_raw_claude_session(prompt: str = "选择 Claude Code 原始会话") -> RawClaudeSession | None:
    raws = load_claude_sessions()
    if not raws:
        print_empty("没有找到 Claude Code 原始会话。")
        return None
    registry = load_registry()
    bound = {s.get("claude_session_id"): s.get("name") for s in registry.get("sessions", []) if s.get("claude_session_id")}
    print_header("Claude Code 原始会话", "按最近更新时间排序；bound 表示已被 ccd 管理。")
    width = ui_width()
    index_width = max(2, len(str(len(raws))))
    row_indent = " " * (4 + index_width)
    title_width = max(12, width - (4 + index_width))
    narrow = width < 78
    for i, raw in enumerate(raws, start=1):
        bound_name = bound.get(raw.id)
        title = short_display_text(raw.title, title_width)
        raw_id = compact_uuid(raw.id)
        time_text = display_time(raw.updated_at)
        print(f"  {cyan(str(i).rjust(index_width))}  {bold(title)}")
        meta = f"id: {raw_id}  {time_text}"
        if not narrow and bound_name:
            bound_text = short_display_text(bound_name, max(8, width - (4 + index_width) - display_len(meta) - 10))
            if display_len(meta) + 10 + display_len(bound_text) <= width - (4 + index_width):
                print(f"{row_indent}{dim(meta)}  {status_text('bound')}: {dim(bound_text)}")
            else:
                print(f"{row_indent}{dim(meta)}")
                print(f"{row_indent}{status_text('bound')}: {dim(bound_text)}")
            continue
        print(f"{row_indent}{dim(meta)}")
        if bound_name:
            bound_text = short_display_text(bound_name, max(8, width - (4 + index_width) - display_len("bound: ")))
            print(f"{row_indent}{status_text('bound')}: {dim(bound_text)}")
    print(rule())
    choice = globals()["prompt"](f"{prompt} [编号/session id，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(raws):
            return raws[idx - 1]
    for raw in raws:
        if raw.id == choice or raw.id.startswith(choice):
            return raw
    print(red("未找到 Claude Code 会话。"))
    return None


def raw_conversation_preview(raw: RawClaudeSession, *, limit: int = 2) -> list[str]:
    user_snippets: list[str] = []
    assistant_snippets: list[str] = []
    seen: set[str] = set()
    if raw.transcript_path and Path(raw.transcript_path).exists():
        try:
            with Path(raw.transcript_path).open("r", encoding="utf-8") as f:
                for idx, line in enumerate(f):
                    if idx > 800 and (user_snippets or assistant_snippets):
                        break
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    text = ""
                    role = ""
                    if item.get("type") in {"user", "assistant"} and not item.get("isMeta"):
                        message = item.get("message")
                        if isinstance(message, dict):
                            role = message.get("role", item.get("type"))
                            text = user_visible_conversation_text(extract_claude_message_text(message))
                    if text and text not in seen:
                        if role == "user":
                            user_snippets.append(text)
                        elif role == "assistant":
                            assistant_snippets.append(text)
                        seen.add(text)
                    if user_snippets and assistant_snippets:
                        break
        except OSError:
            pass
    if user_snippets:
        snippets = [user_snippets[0]]
        if assistant_snippets:
            snippets.append(assistant_snippets[0])
        elif len(user_snippets) > 1:
            snippets.append(user_snippets[1])
        return snippets[:limit]
    if assistant_snippets:
        return assistant_snippets[:limit]
    fallback = user_visible_conversation_text(raw.title)
    return [fallback] if fallback else ["(无可预览内容)"]


def choose_raw_claude_session_for_import(prompt: str = "导入哪个 Claude Code 对话") -> RawClaudeSession | None:
    raws = load_claude_sessions()
