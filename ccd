        print(f"  {cyan(str(i).rjust(index_width))}  {bold(short_display_text(snippets[0], content_width))}")
        for snippet in snippets[1:]:
            print(f"{row_indent}{dim(short_display_text(snippet, content_width))}")
    print(rule())
    choice = globals()["prompt"](f"{prompt} [编号，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(importable):
            return importable[idx - 1]
    for raw in importable:
        if raw.id == choice or raw.id.startswith(choice):
            return raw
    print(red("未找到 Claude Code 会话。"))
    return None


def map_bind(target_session_id: str | None = None, *, force_transfer: bool = False) -> int:
    if target_session_id:
        registry = load_registry()
        target = find_session_by_id(registry, target_session_id)
    else:
        target = choose_ccd_session("绑定到哪个 ccd 会话")
    if not target:
        return 1
    if tmux_exists(target["tmux_session"]):
        print(yellow("该 ccd 会话正在运行，MVP 不允许修改绑定。请先退出 Claude Code。"))
        return 1
    raw = choose_raw_claude_session()
    if not raw:
        return 1
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, target["id"])
        if not current:
            print(red("注册表中找不到目标会话。"))
            return 1
        holder = find_session_by_claude_id(registry, raw.id)
        if holder and holder.get("id") != current.get("id"):
            if tmux_exists(holder["tmux_session"]):
                print(yellow(f"该 Claude Code 会话已绑定到 live 会话：{holder['name']}，不能转移。"))
                return 1
            if not force_transfer:
                print(yellow(f"该 Claude Code 会话已绑定到：{holder['name']}"))
                if not ask_yes_no(f"是否转移绑定到：{current['name']}？", default=False):
                    return 1
            holder["claude_session_id"] = None
            holder["transcript_path"] = None
            holder["updated_at"] = now_utc()
        if current.get("claude_session_id") and current.get("claude_session_id") != raw.id:
            if not ask_yes_no("目标会话已有绑定，是否替换？", default=False):
                return 1
        ts = now_utc()
        current["claude_session_id"] = raw.id
        if raw.cwd:
            current["last_cwd"] = raw.cwd
        current["transcript_path"] = raw.transcript_path
        current["last_viewed_at"] = later_time(ts, path_mtime_iso(raw.transcript_path))
        current["updated_at"] = ts
        save_registry(registry, timestamped_backup=True)
    print(green("绑定完成。"))
    log_event(f"bound ccd id={target['id']} to claude id={raw.id}")
    return 0


def map_import() -> int:
    raw = choose_raw_claude_session_for_import()
    if not raw:
        return 1
    registry = load_registry()
    name = prompt("新的 ccd_name: ")
    try:
        name = validate_name(name)
    except CcdError as exc:
        print(red(f"错误: {exc}"))
        return 1
    if find_session_by_name(registry, name):
        print(red("ccd_name 已存在。"))
        return 1
    cwd = raw.cwd if raw.cwd and Path(raw.cwd).is_dir() else None
    if not cwd:
        print(yellow("无法从 Claude Code 原始会话读取有效 cwd，请选择目录。"))
        cwd = choose_session_directory()
        if not cwd:
            return 1
    try:
        create_record(name, cwd, claude_session_id=raw.id, transcript_path=raw.transcript_path)
    except CcdError as exc:
        print(red(f"错误: {exc}"))
        return 1
    print(green("导入完成。"))
    return 0


def map_unbind() -> int:
