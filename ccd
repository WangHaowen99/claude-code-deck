            "last_used_at": created,
            "last_viewed_at": later_time(created, path_mtime_iso(transcript_path)),
            "transcript_path": transcript_path,
        }
        if fork_from_claude_session_id:
            session["fork_from_claude_session_id"] = fork_from_claude_session_id
        if fork_from_ccd_id:
            session["fork_from_ccd_id"] = fork_from_ccd_id
        registry["sessions"].append(session)
        save_registry(registry)
        log_event(f"created ccd session id={sid} name={name!r}")
        return session


