def tmux_exists(name: str) -> bool:
    if shutil.which("tmux") is None:
        return False
    result = subprocess.run(["tmux", "has-session", "-t", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def tmux_status(session: dict[str, Any]) -> str:
    return "live" if tmux_exists(session["tmux_session"]) else "exited"


def configure_tmux_session(tmux_name: str) -> None:
    if shutil.which("tmux") is None:
        return
    configure_tmux_server()
    options = [
        ("mouse", "on"),
        ("history-limit", str(TMUX_HISTORY_LIMIT)),
        ("remain-on-exit", "off"),
        ("@ccd_scroll_mode", "accelerated-copy-mode"),
    ]
    for option, value in options:
        result = subprocess.run(
            ["tmux", "set-option", "-q", "-t", tmux_name, option, value],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            log_event(f"tmux option failed session={tmux_name} option={option} value={value}: {result.stderr.strip()}")
    install_tmux_mouse_bindings()


def configure_tmux_server() -> None:
    if shutil.which("tmux") is None:
        return
    result = subprocess.run(
        ["tmux", "set-option", "-gq", "mouse", "on"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        log_event(f"tmux global mouse option failed: {result.stderr.strip()}")


def install_tmux_mouse_bindings() -> None:
    if shutil.which("tmux") is None:
        return
    scroll_lines = str(TMUX_SCROLL_LINES)
    bindings = [
        [
            "bind-key",
            "-T",
            "root",
            "WheelUpPane",
            "if-shell",
            "-F",
            "-t",
            "=",
            "#{==:#{@ccd_scroll_mode},accelerated-copy-mode}",
            f"if-shell -F -t = '#{{pane_in_mode}}' 'send-keys -X -N {scroll_lines} scroll-up' 'copy-mode -e -t ='",
            "if-shell -F -t = '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send-keys -M' 'copy-mode -e -t ='",
        ],
        [
            "bind-key",
            "-T",
            "root",
            "WheelDownPane",
            "if-shell",
            "-F",
            "-t",
            "=",
            "#{==:#{@ccd_scroll_mode},accelerated-copy-mode}",
            f"if-shell -F -t = '#{{pane_in_mode}}' \"if-shell -F -t = '#{{pane_at_bottom}}' 'send-keys -X cancel' 'send-keys -X -N {scroll_lines} scroll-down'\" 'send-keys -M'",
            "send-keys -M",
        ],
    ]
    for binding in bindings:
        result = subprocess.run(
            ["tmux", *binding],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            log_event(f"tmux mouse binding failed: {' '.join(binding)}: {result.stderr.strip()}")


def session_is_closed(session: dict[str, Any]) -> bool:
    return bool(session.get("closed_at"))


def active_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    return [session for session in registry.get("sessions", []) if not session_is_closed(session)]


def closed_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    return [session for session in registry.get("sessions", []) if session_is_closed(session)]


def sort_session_list(sessions: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return sorted(
        sessions,
        key=lambda s: (sort_key_time(s.get("last_used_at")) or sort_key_time(s.get("created_at")), s.get("name", "")),
        reverse=True,
    )


def sorted_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    return sort_session_list(active_sessions(registry))


def sorted_closed_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    return sort_session_list(closed_sessions(registry))


def sorted_all_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    return sort_session_list(registry.get("sessions", []))


def short_text(text: str | None, max_len: int = 28) -> str:
    if not text:
        return ""
    return text if len(text) <= max_len else text[: max_len - 1] + "…"


def short_display_text(text: str | None, max_width: int) -> str:
    if not text:
        return ""
    cleaned = re.sub(r"\s+", " ", text).strip()
    if not cleaned or max_width <= 0:
        return ""
    if display_len(cleaned) <= max_width:
        return cleaned
    if max_width <= 1:
        return "…"
    limit = max_width - 1
    width = 0
    pieces: list[str] = []
    for ch in cleaned:
        ch_width = 2 if unicodedata.east_asian_width(ch) in {"F", "W"} else 1
        if width + ch_width > limit:
            break
        pieces.append(ch)
        width += ch_width
    trimmed = "".join(pieces).rstrip()
    return (trimmed + "…") if trimmed else "…"


def compact_uuid(text: str | None) -> str:
    if not text:
        return ""
    value = text.strip()
    if len(value) <= 15:
        return value
    return f"{value[:8]}...{value[-4:]}"


def path_mtime_iso(path: str | None) -> str | None:
    if not path:
        return None
    try:
        mtime = Path(path).stat().st_mtime
    except OSError:
        return None
    return datetime.fromtimestamp(mtime, timezone.utc).isoformat().replace("+00:00", "Z")


def find_claude_transcript_path(claude_id: str | None) -> str | None:
    if not claude_id or not CLAUDE_PROJECTS_DIR.exists():
        return None
    try:
        matches = [path for path in CLAUDE_PROJECTS_DIR.glob(f"**/{claude_id}.jsonl") if path.is_file()]
    except OSError:
        return None
    if not matches:
        return None
    matches.sort(key=lambda path: path.stat().st_mtime if path.exists() else 0, reverse=True)
    return str(matches[0])


def resolve_session_transcript_path(session: dict[str, Any]) -> str | None:
    transcript_path = session.get("transcript_path")
    if transcript_path and Path(transcript_path).exists():
        return transcript_path
    resolved = find_claude_transcript_path(session.get("claude_session_id"))
    return resolved or transcript_path


def later_time(left: str | None, right: str | None) -> str | None:
    left_dt = parse_iso(left)
    right_dt = parse_iso(right)
    if left_dt and right_dt:
        return left if left_dt >= right_dt else right
    return left if left_dt else right


def session_conversation_updated_at(session: dict[str, Any]) -> str | None:
    return path_mtime_iso(resolve_session_transcript_path(session))


def transcript_task_window(path: str | None, *, max_lines: int = 1200) -> tuple[str | None, str | None]:
    if not path:
        return None, None
    transcript = Path(path)
    if not transcript.exists():
        return None, None
    try:
        lines = transcript.read_text(encoding="utf-8", errors="ignore").splitlines()[-max_lines:]
    except OSError:
        return None, None
    latest_started: str | None = None
    latest_complete: str | None = None
    for line in lines:
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        timestamp = item.get("timestamp")
        if not isinstance(timestamp, str) or not parse_iso(timestamp):
            continue
        item_type = item.get("type")
        if item_type == "user" and not item.get("isMeta"):
            latest_started = timestamp
            continue
        if item_type == "assistant":
            message = item.get("message")
            stop_reason = message.get("stop_reason") if isinstance(message, dict) else None
            if stop_reason == "end_turn":
                latest_complete = timestamp
            continue
        if item_type == "system" and item.get("subtype") == "turn_duration":
            latest_complete = timestamp
    return latest_started, latest_complete


def session_activity(session: dict[str, Any], *, now: datetime | None = None) -> dict[str, Any]:
    if not session.get("claude_session_id"):
        return {"state": "none", "started_at": None, "elapsed_seconds": None}
    started_at, completed_at = transcript_task_window(resolve_session_transcript_path(session))
    started_dt = parse_iso(started_at)
    completed_dt = parse_iso(completed_at)
    live = tmux_exists(session["tmux_session"])
    if live and started_dt and (not completed_dt or started_dt > completed_dt):
        now_dt = now or datetime.now(timezone.utc)
        elapsed = max(0, int((now_dt - started_dt).total_seconds()))
        return {"state": "running", "started_at": started_at, "elapsed_seconds": elapsed}
    if session_has_unread_result(session):
        return {"state": "unread", "started_at": None, "elapsed_seconds": None}
    return {"state": "read", "started_at": None, "elapsed_seconds": None}


def session_viewed_at(session: dict[str, Any]) -> str | None:
    return session.get("last_viewed_at") or session.get("last_used_at") or session.get("created_at")


def session_has_unread_result(session: dict[str, Any]) -> bool:
    if not session.get("claude_session_id"):
        return False
    updated_at = session_conversation_updated_at(session)
    if not updated_at:
        return False
    viewed_at = session_viewed_at(session)
    if not viewed_at:
        return True
    updated_dt = parse_iso(updated_at)
    viewed_dt = parse_iso(viewed_at)
    if not updated_dt:
        return False
    if not viewed_dt:
        return True
    return updated_dt > viewed_dt


def view_state_text(session: dict[str, Any]) -> str:
    activity = session_activity(session)
    if activity["state"] == "running":
        return cyan("running")
    if activity["state"] == "unread":
        return red("● unread")
    if activity["state"] == "read":
        return green("● read")
    if not session.get("claude_session_id"):
        return dim("no-result")
    return dim("unknown")


def normalize_preview_text(text: str | None) -> str:
    if not text:
        return ""
    return re.sub(r"\s+", " ", text).strip()


def user_visible_conversation_text(text: str | None) -> str:
    cleaned = normalize_preview_text(text)
    if not cleaned:
        return ""
    internal_prefixes = (
        "<environment_context>",
        "<permissions instructions>",
        "<collaboration_mode>",
        "<skills_instructions>",
        "<local-command-caveat>",
        "<command-name>",
        "<local-command-stdout>",
    )
    return "" if cleaned.startswith(internal_prefixes) else cleaned


def extract_message_content_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    pieces = []
    for item in content:
        if not isinstance(item, dict):
            continue
        if item.get("type") in {"input_text", "output_text", "text"}:
            text = item.get("text")
            if isinstance(text, str):
                pieces.append(text)
    return " ".join(pieces)


def extract_claude_message_text(message: Any) -> str:
    if not isinstance(message, dict):
        return ""
    return extract_message_content_text(message.get("content"))


def timestamp_to_iso(value: Any) -> str | None:
    if value is None:
        return None
    if isinstance(value, str):
        if parse_iso(value):
            return value
        try:
            value = float(value)
        except ValueError:
            return None
    if isinstance(value, (int, float)):
        seconds = float(value) / 1000 if float(value) > 10_000_000_000 else float(value)
        return datetime.fromtimestamp(seconds, timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    return None


