def root_name_exists(config: dict[str, Any], name: str, ignore_id: str | None = None) -> bool:
    return any(r.get("name") == name and r.get("id") != ignore_id for r in config.get("roots", []))


def root_path_exists(config: dict[str, Any], path: str, ignore_id: str | None = None) -> bool:
    return any(str(normalize_path(r.get("path", ""))) == path and r.get("id") != ignore_id for r in config.get("roots", []))


def roots_add(args: list[str]) -> int:
    name = args[0] if len(args) >= 1 else prompt("root 名: ")
    path_raw = args[1] if len(args) >= 2 else prompt("目录路径: ")
    try:
        name = validate_root_name(name)
    except CcdError as exc:
        print(red(f"错误: {exc}"))
        return 1
    path = normalize_path(path_raw)
    if not path.exists():
        if not ask_yes_no(f"目录不存在：{path}，是否创建？", default=False):
            return 1
        try:
            path.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(red(f"创建失败: {exc}"))
            return 1
    if not path.is_dir():
        print(red("路径存在但不是目录。"))
        return 1
    config = load_config()
    if root_name_exists(config, name):
        print(red("root 名已存在。"))
        return 1
    if root_path_exists(config, str(path)):
        print(red("root 路径已存在。"))
        return 1
    rid = re.sub(r"[^A-Za-z0-9_-]+", "-", name).strip("-") or secrets.token_hex(3)
    existing_ids = {r.get("id") for r in config.get("roots", [])}
    base = rid
    n = 2
    while rid in existing_ids:
        rid = f"{base}-{n}"
        n += 1
    config.setdefault("roots", []).append({"id": rid, "name": name, "path": str(path)})
    save_config(config)
    print(green(f"已添加 root: {name} {path}"))
    return 0


def choose_root(prompt: str) -> dict[str, Any] | None:
    config = load_config()
    roots = config.get("roots", [])
    if not roots:
        print_empty("没有常用目录。")
        return None
    print_header("常用目录")
    for i, root in enumerate(roots, start=1):
        print(f"  {cyan(str(i).rjust(2))}  {bold(root['name'])}")
        print(f"      {dim(root['path'])}")
    print(rule())
    choice = globals()["prompt"](f"{prompt} [编号/名称，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(roots):
            return roots[idx - 1]
    for root in roots:
        if root.get("name") == choice:
            return root
    print(red("未找到 root。"))
    return None


def roots_delete(args: list[str]) -> int:
    config = load_config()
    if len(config.get("roots", [])) <= 1:
        print(yellow("不能删除最后一个常用目录。"))
        return 1
    if args:
        target = next((r for r in config.get("roots", []) if r.get("name") == args[0]), None)
    else:
        target = choose_root("删除哪个 root")
    if not target:
        return 1
    root_path = normalize_path(target["path"])
    registry = load_registry()
    affected = []
    for session in registry.get("sessions", []):
        last_cwd = session.get("last_cwd")
        if not last_cwd:
            continue
        try:
            Path(last_cwd).resolve(strict=False).relative_to(root_path)
            affected.append(session)
        except ValueError:
            pass
    if affected:
        print(yellow(f"有 {len(affected)} 个会话的 last_cwd 位于该目录下；删除 root 不会删除这些会话或目录。"))
    if not ask_yes_no(f"确认删除 root：{target['name']}？", default=False):
        return 1
    config["roots"] = [r for r in config.get("roots", []) if r.get("id") != target.get("id")]
    save_config(config)
    print(green("已删除 root。"))
    return 0


