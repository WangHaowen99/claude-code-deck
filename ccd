def cmd_doctor(_: list[str]) -> int:
    problems = 0
    print_header(f"{APP_NAME} doctor", "只报告问题，不自动修改状态。")
    for label, path in (("配置", CONFIG_PATH), ("注册表", REGISTRY_PATH)):
        if path.exists():
            try:
                load_json(path, {})
                print(f"{green('OK ')} {label}: {dim(str(path))}")
            except Exception as exc:
                print(f"{red('ERR')} {label} JSON 无效: {exc}")
                problems += 1
        else:
            print(f"{red('ERR')} {label} 不存在: {path}")
            problems += 1

    if is_hook_installed():
        print(f"{green('OK ')} SessionStart hook 已安装: {dim(str(CLAUDE_SETTINGS_PATH))}")
    else:
        print(f"{red('ERR')} SessionStart hook 未安装: {CLAUDE_SETTINGS_PATH}")
        problems += 1

    try:
        config = load_config()
        root_names = [r.get("name") for r in config.get("roots", [])]
        root_paths = [str(normalize_path(r.get("path", ""))) for r in config.get("roots", [])]
        if len(root_names) != len(set(root_names)):
            print(f"{red('ERR')} root 名重复")
            problems += 1
        if len(root_paths) != len(set(root_paths)):
            print(f"{red('ERR')} root 路径重复")
            problems += 1
        for root in config.get("roots", []):
            if Path(root.get("path", "")).expanduser().is_dir():
                print(f"{green('OK ')} root: {bold(root.get('name'))} {dim(root.get('path'))}")
            else:
                print(f"{yellow('WARN')} root 不存在或不是目录: {root.get('name')} {root.get('path')}")
    except Exception as exc:
        print(f"{red('ERR')} 读取配置失败: {exc}")
        problems += 1

    raw_ids = {s.id for s in load_claude_sessions()}
    try:
        registry = load_registry()
        names = [s.get("name") for s in registry.get("sessions", [])]
        claude_ids = [s.get("claude_session_id") for s in registry.get("sessions", []) if s.get("claude_session_id")]
        if len(names) != len(set(names)):
            print(f"{red('ERR')} ccd_name 重复")
            problems += 1
        if len(claude_ids) != len(set(claude_ids)):
            print(f"{red('ERR')} claude_session_id 重复绑定")
            problems += 1
        for session in sorted_sessions(registry):
            prefix = f"{session.get('name')} ({session.get('id')})"
            status = tmux_status(session)
            bound = session.get("claude_session_id")
            binding = "yes" if bound else "no"
            print(f"{green('OK ')} session {bold(prefix)}: tmux={status_text(status)} binding={status_text('bound') if bound else dim(binding)}")
            if bound and bound not in raw_ids:
                print(f"{yellow('WARN')} {prefix}: Claude Code 原始会话不在本地索引/rollout 中: {bound}")
            cwd = session.get("last_cwd")
            if cwd and not Path(cwd).is_dir():
                print(f"{yellow('WARN')} {prefix}: last_cwd 不存在: {cwd}")
    except Exception as exc:
        print(f"{red('ERR')} 读取注册表失败: {exc}")
        problems += 1

    if problems:
        print(rule())
        print(red(f"doctor 完成，发现 {problems} 个错误。"))
        return 1
    print(rule())
    print(green("doctor 完成，没有发现阻塞性错误。"))
    return 0


def cmd_runner(args: list[str]) -> int:
    if not args:
        print("missing ccd id", file=sys.stderr)
        return 2
    pane_index: int | None = None
    filtered: list[str] = []
    skip = False
    for i, arg in enumerate(args):
        if skip:
            skip = False
            continue
        if arg == "--pane-index" and i + 1 < len(args):
            try:
                pane_index = int(args[i + 1])
            except ValueError:
                print(f"invalid --pane-index value: {args[i+1]}", file=sys.stderr)
                return 2
            skip = True
            continue
        filtered.append(arg)
    args = filtered
    session_id = args[0]
    try:
        registry = load_registry()
        session = find_session_by_id(registry, session_id)
        if not session:
            print(f"ccd runner: 注册表中找不到会话 {session_id}")
            input("按 Enter 退出...")
            return 1
        cwd = session.get("last_cwd") or str(HOME)
        if not Path(cwd).is_dir():
            print(f"ccd runner: 工作目录不存在: {cwd}")
            print("请退出后运行 ccd doctor 或 ccd enter 修复。")
            input("按 Enter 退出...")
            return 1
        os.chdir(cwd)
        env = os.environ.copy()
        env["CCD_SESSION_ID"] = session["id"]
        env["CCD_NAME"] = session["name"]
        env["CCD_REGISTRY"] = str(REGISTRY_PATH)
        if session.get("type") == "triple" and pane_index is not None:
            env["CCD_PANE_INDEX"] = str(pane_index)
            claude_args = claude_args_for_pane(session, pane_index)
        else:
            claude_args = claude_args_for_session(session)
        log_event(f"runner starting {' '.join(claude_args)} for ccd id={session['id']} pane={pane_index}")
        result = subprocess.run(claude_args, env=env)
        if result.returncode != 0:
            log_event(f"runner claude exited rc={result.returncode} ccd id={session['id']}")
            print(f"\nClaude Code 退出码：{result.returncode}")
            print("如果是 resume 失败，请运行 ccd map 或 ccd doctor 修复映射。")
            try:
                input("按 Enter 退出 tmux...")
            except EOFError:
                pass
        return result.returncode
    except KeyboardInterrupt:
        return 130


def claude_args_for_session(session: dict[str, Any]) -> list[str]:
    if session.get("claude_session_id"):
        return ["claude", "--resume", session["claude_session_id"]]
    if session.get("fork_from_claude_session_id"):
        return ["claude", "--resume", session["fork_from_claude_session_id"], "--fork-session"]
    return ["claude", "--name", session["name"]]


def claude_args_for_pane(session: dict[str, Any], pane_index: int) -> list[str]:
    panes = session.get("panes", [])
    if pane_index < len(panes):
        pane = panes[pane_index]
    else:
        return ["claude"]
    args: list[str] = ["claude"]
    if pane.get("model"):
        args.extend(["--model", pane["model"]])
    if pane.get("claude_session_id"):
        args.extend(["--resume", pane["claude_session_id"]])
    else:
        args.extend(["--name", f"{session['name']}-{pane.get('provider', 'p')}{pane_index}"])
    return args


def cmd_hook_session_start(_: list[str]) -> int:
    ccd_id = os.environ.get("CCD_SESSION_ID")
    if not ccd_id:
        return 0
    pane_index_str = os.environ.get("CCD_PANE_INDEX")
    pane_index = int(pane_index_str) if pane_index_str is not None else None
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        log_event(f"hook invalid json ccd_id={ccd_id}: {exc}")
        return 0
    claude_id = payload.get("session_id") or payload.get("thread_id") or payload.get("id")
    if not claude_id:
        log_event(f"hook missing session_id ccd_id={ccd_id}")
        return 0
    cwd = payload.get("cwd")
    transcript_path = payload.get("transcript_path")
    source = payload.get("source")
    with registry_lock():
        registry = load_registry()
        session = find_session_by_id(registry, ccd_id)
        if not session:
            log_event(f"hook ccd session not found ccd_id={ccd_id} claude_id={claude_id}")
            return 0
        ts = now_utc()
        if pane_index is not None and session.get("type") == "triple":
            panes = session.get("panes", [])
            if pane_index < len(panes):
                pane = panes[pane_index]
                existing = pane.get("claude_session_id")
                if existing and existing != claude_id:
                    log_event(f"hook conflict ccd_id={ccd_id} pane={pane_index} existing={existing} incoming={claude_id}")
                    return 0
                pane["claude_session_id"] = claude_id
                pane["transcript_path"] = transcript_path or find_claude_transcript_path(claude_id) or pane.get("transcript_path")
        else:
            existing = session.get("claude_session_id")
            if existing and existing != claude_id:
                log_event(f"hook conflict ccd_id={ccd_id} existing={existing} incoming={claude_id} source={source}")
                return 0
            session["claude_session_id"] = claude_id
            session["transcript_path"] = transcript_path or find_claude_transcript_path(claude_id) or session.get("transcript_path")
        if cwd:
            session["last_cwd"] = cwd
        session["last_used_at"] = ts
        session["last_viewed_at"] = later_time(ts, session_conversation_updated_at(session))
        session["updated_at"] = ts
        save_registry(registry)
    log_event(f"hook mapped ccd_id={ccd_id} claude_id={claude_id} pane={pane_index} source={source}")
    return 0


