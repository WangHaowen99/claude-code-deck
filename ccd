def cmd_triple_new(args: list[str]) -> int:
    args = list(args)
    json_mode = take_flag(args, "--json")
    no_enter = take_flag(args, "--no-enter") or json_mode
    try:
        cwd_arg = take_option(args, "--cwd")
    except CcdError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    try:
        require_tool("tmux")
        require_tool("claude")
    except CcdError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    pane_overrides: dict[int, dict[str, str]] = {}
    filtered_args: list[str] = []
    i = 0
    while i < len(args):
        if args[i] == "--pane" and i + 1 < len(args):
            try:
                parts = args[i + 1].split(":", 2)
                pane_idx = int(parts[0])
                provider = parts[1] if len(parts) > 1 else "anthropic"
                model = parts[2] if len(parts) > 2 else ""
                pane_overrides[pane_idx] = {"provider": provider, "model": model}
            except (ValueError, IndexError):
                print_error(f"无效的 --pane 格式: {args[i+1]}，应为 INDEX:PROVIDER:MODEL", json_mode=json_mode)
                return 1
            i += 2
            continue
        filtered_args.append(args[i])
        i += 1
    args = filtered_args
    if args:
        name = " ".join(args).strip()
    elif no_enter:
        print_error("缺少 ccd_name。", json_mode=json_mode)
        return 1
    else:
        name = prompt("ccd_name: ")
    try:
        name = validate_name(name)
    except CcdError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    registry = load_registry()
    existing = find_session_by_name(registry, name)
    if existing:
        if session_is_closed(existing):
            print_error(f"会话“{name}”已关闭，请使用 ccd reopen 恢复。", json_mode=json_mode)
            return 1
        if json_mode:
            emit_json({"ok": True, "existing": True, "session": session_json(existing)})
            return 0
        print(cyan(f"会话“{name}”已存在，直接进入。"))
        if no_enter:
            return 0
        return enter_session(existing)
    if cwd_arg is not None:
        try:
            cwd = ensure_cwd_path(cwd_arg)
        except (CcdError, OSError) as exc:
            print_error(f"错误: {exc}", json_mode=json_mode)
            return 1
    else:
        if no_enter:
            print_error("非交互新建会话需要 --cwd。", json_mode=json_mode)
            return 1
        cwd = choose_session_directory()
        if not cwd:
            return 1
    if pane_overrides:
        panes_config = [
            pane_overrides.get(j, TRIPLE_PANE_DEFAULTS[j])
            for j in range(3)
        ]
    elif json_mode:
        panes_config = TRIPLE_PANE_DEFAULTS
    else:
        panes_config = configure_triple_panes()
        if panes_config is None:
            print(dim("已取消。"))
            return 1
    try:
        session = create_triple_record(name, cwd, panes_config)
    except CcdError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    if json_mode:
        emit_json({"ok": True, "existing": False, "session": session_json(session)})
    if no_enter:
        return 0
    return enter_triple_session(session)


def cmd_triple_enter(args: list[str]) -> int:
    session = resolve_session_arg(args, "进入哪个 triple 会话")
    if not session:
        return 1
    if session.get("type") != "triple":
        print_error("该会话不是 triple 类型，请使用 ccd enter。")
        return 1
    if session_is_closed(session):
        print_error(f"会话“{session.get('name', '')}”已关闭，请使用 ccd reopen 恢复。")
        return 1
    return enter_triple_session(session)


def cmd_triple_close(args: list[str]) -> int:
    args = list(args)
    json_mode = take_flag(args, "--json")
    yes = take_flag(args, "--yes")
    session = resolve_session_arg(args, "关闭哪个 triple 会话", noninteractive=json_mode or yes, json_mode=json_mode)
    if not session:
        return 1
    if session.get("type") != "triple":
        print_error("该会话不是 triple 类型，请使用 ccd close。", json_mode=json_mode)
        return 1
    already_closed = session_is_closed(session)
    live = tmux_exists(session["tmux_session"]) if not already_closed else False
    if not already_closed and not yes:
        print_header("关闭确认", "会话会移入历史，可用 ccd reopen 恢复。")
        print(f"  会话: {bold(session['name'])}")
        print(f"  tmux: {status_text('live') if live else dim('exited')}")
        for p in session.get("panes", []):
            bound = "bound" if p.get("claude_session_id") else "unbound"
            print(f"  窗口 {p['index']}: {p['provider']}/{p['model']}  {status_text(bound)}")
        print(rule())
        if not ask_yes_no("确定关闭？", default=False):
            return 0
    if live:
        subprocess.run(["tmux", "kill-session", "-t", session["tmux_session"]],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if current:
            current["closed_at"] = now_utc()
            current["updated_at"] = now_utc()
            save_registry(registry)
    log_event(f"closed triple session id={session['id']}")
    if json_mode:
        emit_json({"ok": True, "closed": True, "session": session_json(session)})
        return 0
    print(green(f"已关闭: {session['name']}"))
    return 0


def cmd_triple_broadcast(args: list[str]) -> int:
