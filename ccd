def take_flag(args: list[str], flag: str) -> bool:
    found = False
    kept = []
    for arg in args:
        if arg == flag:
            found = True
        else:
            kept.append(arg)
    args[:] = kept
    return found


def take_option(args: list[str], option: str) -> str | None:
    for i, arg in enumerate(list(args)):
        if arg == option:
            if i + 1 >= len(args):
                raise CcdError(f"{option} 需要参数。")
            value = args[i + 1]
            del args[i : i + 2]
            return value
        prefix = option + "="
        if arg.startswith(prefix):
            value = arg[len(prefix) :]
            del args[i]
            return value
    return None


