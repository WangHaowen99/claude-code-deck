        new_name = " ".join(args[1:]).strip() if len(args) > 1 else prompt("新的 ccd_name: ")
        registry = load_registry()
        session = find_session_by_name(registry, old_name)
        if not session:
            print_error(f"未找到会话: {old_name}", json_mode=json_mode)
            return 1
    else:
        if json_mode:
            print_error("缺少 OLD 和 NEW。", json_mode=True)
            return 1
        session = choose_ccd_session("重命名哪个会话")
        if not session:
            return 1
        new_name = prompt("新的 ccd_name: ")
    try:
        new_name = validate_name(new_name)
    except CcdError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    renamed_session: dict[str, Any] | None = None
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if not current:
            print_error("注册表中找不到该会话。", json_mode=json_mode)
            return 1
        dup = find_session_by_name(registry, new_name)
        if dup and dup.get("id") != current["id"]:
            print_error(f"会话名已存在: {new_name}", json_mode=json_mode)
            return 1
        old = current["name"]
        current["name"] = new_name
        current["updated_at"] = now_utc()
        renamed_session = dict(current)
        save_registry(registry, timestamped_backup=True)
    if tmux_exists(session["tmux_session"]):
        subprocess.run(
            ["tmux", "rename-window", "-t", f"{session['tmux_session']}:0", short_text(new_name, 30)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    log_event(f"renamed ccd session id={session['id']} {old!r}->{new_name!r}")
    if json_mode:
        emit_json({"ok": True, "old_name": old, "session": session_json(renamed_session or session)})
        return 0
    print(green(f"已重命名: {old} -> {new_name}"))
    return 0


def cmd_roots(args: list[str]) -> int:
    sub = args[0] if args else ""
    rest = args[1:] if args else []
    if sub in {"list", "ls"}:
        return roots_list()
    if sub == "add":
        return roots_add(rest)
    if sub in {"delete", "del", "rm"}:
        return roots_delete(rest)
    if sub in {"rename", "ren", "mv"}:
