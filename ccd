    choice = globals()["prompt"](f"{prompt} [编号/名称，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(items):
            return items[idx - 1]
    for item in items:
        if label_fn(item) == choice or getattr(item, "id", None) == choice:
            return item
    print(red("无效选择。"))
    return None


