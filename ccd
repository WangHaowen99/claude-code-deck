def create_tmux_if_needed(session: dict[str, Any]) -> bool:
    require_tool("tmux")
    require_tool("claude")
    tmux_name = session["tmux_session"]
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if not current:
            raise CcdError("注册表中找不到该会话。")
        if tmux_exists(tmux_name):
            configure_tmux_session(tmux_name)
            return True
        window_name = short_text(current["name"], 30) or "ccd"
        command = f"{shlex.quote(current_ccd_path())} __runner {shlex.quote(current['id'])}"
        result = subprocess.run(
            ["tmux", "new-session", "-d", "-s", tmux_name, "-n", window_name, command],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode != 0:
            print(f"创建 tmux 失败: {result.stderr.strip() or result.stdout.strip()}")
            return False
        configure_tmux_session(tmux_name)
        log_event(f"created tmux session {tmux_name} for ccd id={current['id']}")
        return True


def attach_tmux(session: dict[str, Any]) -> int:
    tmux_name = session["tmux_session"]
    configure_tmux_session(tmux_name)
    if os.environ.get("TMUX"):
        result = subprocess.run(["tmux", "switch-client", "-t", tmux_name])
    else:
        result = subprocess.run(["tmux", "attach-session", "-t", tmux_name])
    if result.returncode != 0:
        print(f"进入 tmux 失败，session 已保留: {tmux_name}")
    return result.returncode


def create_triple_tmux(session: dict[str, Any]) -> bool:
    require_tool("tmux")
    require_tool("claude")
    tmux_name = session["tmux_session"]
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if not current:
            raise CcdError("注册表中找不到该会话。")
        if tmux_exists(tmux_name):
            configure_tmux_session(tmux_name)
            return True
        window_name = short_text(current["name"], 30) or "ccd"
        runner = shlex.quote(current_ccd_path())
        sid = current["id"]
        use_script = shlex.quote(CLAUDE_USE_SCRIPT)
        panes = current.get("panes", [])
        # Build a bash wrapper for each pane: source claude-use.sh, switch provider, then run runner
        pane_cmds: list[str] = []
        for pane_order in [0, 2, 1]:  # creation order: top-left, bottom, top-right
            provider = ""
            for p in panes:
                if p.get("index") == pane_order:
                    provider = p.get("provider", "")
                    break
            provider_switch = f"claude-use {shlex.quote(provider)}" if provider else "true"
            pane_cmds.append(
                f"bash -c 'source {use_script}; {provider_switch} || true; "
                f"exec {runner} __runner {sid} --pane-index {pane_order}'"
            )
        commands = [
            ["tmux", "new-session", "-d", "-s", tmux_name, "-n", window_name, pane_cmds[0]],
            ["tmux", "split-window", "-v", "-l", "30%", "-t", f"{tmux_name}:0.0", pane_cmds[1]],
            ["tmux", "split-window", "-h", "-t", f"{tmux_name}:0.0", pane_cmds[2]],
        ]
        for cmd in commands:
            result = subprocess.run(
                cmd,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            if result.returncode != 0:
                print(f"创建 triple tmux 失败: {result.stderr.strip() or result.stdout.strip()}")
                subprocess.run(["tmux", "kill-session", "-t", tmux_name],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return False
        configure_tmux_session(tmux_name)
        configure_triple_tmux_options(tmux_name)
        log_event(f"created triple tmux session {tmux_name} for ccd id={sid}")
        return True


def configure_triple_tmux_options(tmux_name: str) -> None:
    if shutil.which("tmux") is None:
        return
    subprocess.run(
        ["tmux", "set-window-option", "-t", f"{tmux_name}:0", "synchronize-panes", "off"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    toggle_cmd = (
        f"if-shell -F -t {tmux_name}:0 '#{{synchronize-panes}}' "
        f"'set-window-option -t {tmux_name}:0 synchronize-panes off; display-message \"Broadcast OFF\"' "
        f"'set-window-option -t {tmux_name}:0 synchronize-panes on; display-message \"Broadcast ON\"'"
    )
    subprocess.run(
        ["tmux", "bind-key", "-t", tmux_name, "C-b", "run-shell", toggle_cmd],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def triple_broadcast_toggle(session: dict[str, Any], state: str | None = None) -> bool:
    tmux_name = session["tmux_session"]
    if state is None:
        result = subprocess.run(
            ["tmux", "show-window-options", "-t", f"{tmux_name}:0", "synchronize-panes"],
            capture_output=True, text=True,
        )
        current = "on" in result.stdout
        state = "off" if current else "on"
    subprocess.run(
        ["tmux", "set-window-option", "-t", f"{tmux_name}:0", "synchronize-panes", state],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    status_msg = f"Broadcast {'ON' if state == 'on' else 'OFF'}"
    subprocess.run(
        ["tmux", "display-message", "-t", tmux_name, status_msg],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    log_event(f"triple broadcast {state} for {tmux_name}")
    return state == "on"


def triple_broadcast_status(session: dict[str, Any]) -> bool:
    result = subprocess.run(
        ["tmux", "show-window-options", "-t", f"{session['tmux_session']}:0", "synchronize-panes"],
        capture_output=True, text=True,
    )
    return "on" in result.stdout


def touch_last_used(session_id: str, *, mark_viewed: bool = False) -> None:
    with registry_lock():
        registry = load_registry()
        session = find_session_by_id(registry, session_id)
        if not session:
            return
        ts = now_utc()
        session["last_used_at"] = ts
        session["updated_at"] = ts
        if mark_viewed:
            session["last_viewed_at"] = later_time(ts, session_conversation_updated_at(session))
        save_registry(registry)


def mark_session_viewed(session_id: str) -> dict[str, Any] | None:
    with registry_lock():
        registry = load_registry()
        session = find_session_by_id(registry, session_id)
        if not session:
            return None
        ts = now_utc()
        session["last_used_at"] = ts
        session["last_viewed_at"] = later_time(ts, session_conversation_updated_at(session))
        session["updated_at"] = ts
        save_registry(registry)
        return dict(session)


def enter_triple_session(session: dict[str, Any]) -> int:
    """Enter a triple session; rebuild tmux if needed."""
    if tmux_exists(session["tmux_session"]):
        touch_last_used(session["id"], mark_viewed=True)
        return attach_tmux(session)
    if not ensure_last_cwd(session):
        return 1
    touch_last_used(session["id"], mark_viewed=True)
    if not create_triple_tmux(session):
        return 1
    return attach_tmux(session)


def enter_session(session: dict[str, Any], *, unbound_mode: str = "prompt") -> int:
    if session.get("type") == "triple":
        return enter_triple_session(session)
    if tmux_exists(session["tmux_session"]):
        touch_last_used(session["id"], mark_viewed=True)
        return attach_tmux(session)
    if not session.get("claude_session_id"):
        if unbound_mode == "new":
            pass
        else:
            print_menu(
                f"未绑定: {session['name']}",
                [
                    ("1", "新建 Claude Code 会话并绑定", "启动新的 Claude Code TUI，hook 会回写 session id"),
                    ("2", "绑定已有 Claude Code 会话", "从 Claude Code 原始历史里选择一个会话"),
                    ("3", "取消", "返回上一级"),
                ],
                "该 ccd 会话还没有绑定 Claude Code 原始会话。",
            )
            choice = prompt("请选择: ")
            if choice == "2":
                if map_bind(target_session_id=session["id"]) == 0:
                    with registry_lock():
                        registry = load_registry()
                        refreshed = find_session_by_id(registry, session["id"])
                        if refreshed:
                            session = refreshed
                    if not session.get("claude_session_id"):
                        return 1
                else:
                    return 1
            elif choice != "1":
                print(dim("已取消。"))
                return 1
    if not ensure_last_cwd(session):
        return 1
    touch_last_used(session["id"], mark_viewed=True)
    if not create_tmux_if_needed(session):
        return 1
    return attach_tmux(session)


