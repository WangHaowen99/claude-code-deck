def current_ccd_path() -> str:
    arg0 = Path(sys.argv[0])
    if arg0.is_absolute() and arg0.exists():
        return str(arg0.resolve())
    found = shutil.which("ccd")
    if found:
        return str(Path(found).resolve())
    return str(arg0.resolve(strict=False))


def is_hook_installed() -> bool:
    if not CLAUDE_SETTINGS_PATH.exists():
        return False
    try:
        settings = load_json(CLAUDE_SETTINGS_PATH, {})
    except Exception:
        return False
    for group in settings.get("hooks", {}).get("SessionStart", []):
        for hook in group.get("hooks", []):
            command = hook.get("command", "")
            if "__hook-session-start" in command:
                return True
    return False


def install_settings_hook() -> None:
    CLAUDE_HOME.mkdir(parents=True, exist_ok=True)
    settings = load_json(CLAUDE_SETTINGS_PATH, {})
    if not isinstance(settings, dict):
        raise CcdError(f"{CLAUDE_SETTINGS_PATH} 格式不兼容：settings 必须是对象。")
    if "hooks" in settings and not isinstance(settings.get("hooks"), dict):
        raise CcdError(f"{CLAUDE_SETTINGS_PATH} 格式不兼容：hooks 必须是对象。")
    events = settings.setdefault("hooks", {})
    groups = events.setdefault("SessionStart", [])
    if not isinstance(groups, list):
        raise CcdError(f"{CLAUDE_SETTINGS_PATH} 格式不兼容：SessionStart 必须是数组。")

    cleaned = []
    for group in groups:
        group_hooks = group.get("hooks", []) if isinstance(group, dict) else []
        kept_hooks = [h for h in group_hooks if "__hook-session-start" not in h.get("command", "")]
        if kept_hooks:
            next_group = dict(group)
            next_group["hooks"] = kept_hooks
            cleaned.append(next_group)
    command = f"{shlex.quote(current_ccd_path())} __hook-session-start"
    cleaned.append(
        {
            "matcher": "^(startup|resume)$",
            "hooks": [
                {
                    "type": "command",
                    "command": command,
                    "timeout": 10,
                    "statusMessage": CCD_HOOK_STATUS,
                }
            ],
        }
    )
    events["SessionStart"] = cleaned
    write_json_atomic(CLAUDE_SETTINGS_PATH, settings, backup=CLAUDE_SETTINGS_PATH.exists(), timestamped=True)
    log_event(f"installed session-start hook: {command}")


def install_hook_interactive(auto: bool = False) -> bool:
    if auto:
        print("ccd 需要安装 Claude Code SessionStart hook 到 ~/.claude/settings.json。")
    if not ask_yes_no("继续安装/校验 hook？", default=True):
        print("已取消 hook 安装。")
        return False
    install_settings_hook()
    print("hook 已安装。")
    return True


def cmd_init(auto: bool = False) -> int:
    ensure_dirs()
    if not CONFIG_PATH.exists():
        save_config(default_config())
        print(f"已创建配置: {CONFIG_PATH}")
    if not REGISTRY_PATH.exists():
        save_registry(default_registry())
        print(f"已创建注册表: {REGISTRY_PATH}")
    if not is_hook_installed():
        if not install_hook_interactive(auto=auto):
            return 1
    else:
        print("hook 已安装。")
    log_event("init completed")
    return 0


def ensure_initialized() -> bool:
    if CONFIG_PATH.exists() and REGISTRY_PATH.exists() and is_hook_installed():
        return True
    print("ccd 尚未初始化或 hook 缺失，先运行 init。")
    return cmd_init(auto=True) == 0


def create_record(
    name: str,
    cwd: str,
    claude_session_id: str | None = None,
    transcript_path: str | None = None,
    *,
    fork_from_claude_session_id: str | None = None,
    fork_from_ccd_id: str | None = None,
) -> dict[str, Any]:
    with registry_lock():
        registry = load_registry()
        if find_session_by_name(registry, name):
            raise CcdError(f"会话已存在: {name}")
        sid = unique_session_id(registry)
        created = now_utc()
        session = {
            "id": sid,
            "name": name,
            "tmux_session": f"ccd_{sid}",
            "claude_session_id": claude_session_id,
            "last_cwd": cwd,
            "created_at": created,
