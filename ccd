    bound_ids = {s.get("claude_session_id") for s in registry.get("sessions", []) if s.get("claude_session_id")}
    importable = [raw for raw in raws if raw.id not in bound_ids][:RAW_IMPORT_PREVIEW_LIMIT]
    if not importable:
        print_empty("没有可导入的未绑定 Claude Code 原始会话。")
        return None
    print_header("导入 Claude Code 对话", f"显示最近 {RAW_IMPORT_PREVIEW_LIMIT} 次未管理的 Claude Code 对话；只显示对话内容。")
    width = ui_width()
    index_width = max(2, len(str(len(importable))))
    row_indent = " " * (4 + index_width)
    content_width = max(12, width - (4 + index_width))
    for i, raw in enumerate(importable, start=1):
