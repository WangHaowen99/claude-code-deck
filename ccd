def cmd_close(args: list[str]) -> int:
    args = list(args)
    json_mode = take_flag(args, "--json")
    yes = take_flag(args, "--yes")
    noninteractive = json_mode or yes
    session = resolve_session_arg(args, "关闭哪个会话", noninteractive=noninteractive, json_mode=json_mode)
    if not session:
        return 1
    already_closed = session_is_closed(session)
    live = tmux_exists(session["tmux_session"]) if not already_closed else False
    if not already_closed and not yes:
        print_header("关闭确认", "会话会移入历史，可用 ccd reopen 恢复；不会删除 Claude Code 原始历史。")
        print(f"  会话: {bold(session['name'])}")
        print(f"  tmux: {status_text('live') if live else dim('exited')}")
        print()
        print("  将执行:")
        print("  - 从主列表隐藏，保留在历史 ccd")
        if live:
            print("  - tmux 正在运行，会被关闭并中断 Claude Code")
        else:
            print("  - tmux 未运行")
        print("  - 保留 Claude Code session id、transcript 和指标")
        confirm = prompt("输入完整会话名确认: ")
        if confirm != session["name"]:
            print(yellow("确认不匹配，已取消。"))
            return 1
    if live:
        subprocess.run(["tmux", "kill-session", "-t", session["tmux_session"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        log_event(f"killed tmux session {session['tmux_session']} during close")
    closed_session = dict(session)
    if not already_closed:
        with registry_lock():
            registry = load_registry()
            current = find_session_by_id(registry, session["id"])
            if not current:
                print_error("注册表中找不到该会话。", json_mode=json_mode)
                return 1
            ts = now_utc()
            current["closed_at"] = ts
            current["updated_at"] = ts
            closed_session = dict(current)
            save_registry(registry, timestamped_backup=True)
        log_event(f"closed ccd session id={session['id']} name={session['name']!r}")
    if json_mode:
        emit_json(
            {
                "ok": True,
                "already_closed": already_closed,
                "killed_tmux": live,
                "session": session_json(closed_session, include_status=False),
            }
        )
        return 0
    if already_closed:
        print(dim("该会话已在历史中。"))
    else:
        print(green("已关闭，会话已移入历史。"))
    return 0


def reopen_session(session_id: str, *, enter: bool = False, json_mode: bool = False) -> int:
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session_id)
        if not current:
            print_error("注册表中找不到该会话。", json_mode=json_mode)
            return 1
        if session_is_closed(current):
            current.pop("closed_at", None)
            ts = now_utc()
            current["updated_at"] = ts
            current["last_used_at"] = ts
            save_registry(registry, timestamped_backup=True)
        reopened = dict(current)
    log_event(f"reopened ccd session id={session_id} name={reopened.get('name', '')!r}")
    enter_rc = 0
    if enter:
        enter_rc = enter_session(reopened)
    if json_mode:
        emit_json({"ok": enter_rc == 0, "entered": enter, "enter_rc": enter_rc, "session": session_json(reopened)})
    elif not enter:
        print(green(f"已重新打开: {reopened.get('name', '')}"))
    return enter_rc


