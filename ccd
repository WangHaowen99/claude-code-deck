def dispatch(argv: list[str]) -> int:
    if not argv:
        if not ensure_initialized():
            return 1
        return main_menu()
    cmd, rest = argv[0], argv[1:]
    if cmd in {"-h", "--help", "help"}:
        print(usage())
        return 0
    if cmd == "__runner":
        return cmd_runner(rest)
    if cmd == "__hook-session-start":
        return cmd_hook_session_start(rest)
    if cmd == "init":
        return cmd_init()
    if cmd == "install-hook":
        return 0 if install_hook_interactive(auto=False) else 1
    if cmd == "doctor":
        return cmd_doctor(rest)
    if not ensure_initialized():
        return 1
    commands = {
        "list": cmd_list,
        "ls": cmd_list,
        "new": cmd_new,
        "add": cmd_new,
        "create": cmd_new,
        "fork": cmd_fork,
        "enter": cmd_enter,
        "open": cmd_enter,
        "close": cmd_close,
