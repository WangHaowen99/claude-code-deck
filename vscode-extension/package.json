{
  "name": "claude-code-deck",
  "displayName": "Claude Code Deck",
  "description": "Manage Claude Code Deck sessions from the VS Code sidebar.",
  "version": "0.1.5",
  "publisher": "claude-code-deck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WangHaowen99/claude-code-deck.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:claudeCodeDeck.sessions",
    "onCommand:claudeCodeDeck.refresh",
    "onCommand:claudeCodeDeck.newSession",
    "onCommand:claudeCodeDeck.newTripleSession",
    "onCommand:claudeCodeDeck.openSession",
    "onCommand:claudeCodeDeck.forkSession",
    "onCommand:claudeCodeDeck.closeSession",
    "onCommand:claudeCodeDeck.reopenSession",
    "onCommand:claudeCodeDeck.deleteSession",
    "onCommand:claudeCodeDeck.renameSession",
    "onCommand:claudeCodeDeck.copyUuid"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Claude Code Deck",
      "properties": {
        "claudeCodeDeck.ccdPath": {
          "type": "string",
          "default": "ccd",
          "description": "Path to the ccd executable on the remote/workspace host."
        },
        "claudeCodeDeck.defaultCwd": {
          "type": "string",
          "default": "",
          "description": "Default working directory for new Claude Code Deck sessions. Empty uses the first workspace folder or the remote home directory."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeDeck",
          "title": "Claude Code Deck",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeCodeDeck": [
        {
          "id": "claudeCodeDeck.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCodeDeck.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeCodeDeck.newSession",
        "title": "New Session",
        "icon": "$(add)"
      },
      {
        "command": "claudeCodeDeck.newTripleSession",
        "title": "New Triple Session (3 Models)",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "claudeCodeDeck.openSession",
        "title": "Open Session",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeCodeDeck.forkSession",
        "title": "Fork Session",
        "icon": "$(git-branch)"
      },
      {
        "command": "claudeCodeDeck.closeSession",
        "title": "Close Session",
        "icon": "$(archive)"
      },
      {
        "command": "claudeCodeDeck.reopenSession",
        "title": "Reopen Closed Session",
        "icon": "$(history)"
      },
      {
        "command": "claudeCodeDeck.renameSession",
        "title": "Rename Session",
        "icon": "$(edit)"
      },
      {
        "command": "claudeCodeDeck.deleteSession",
        "title": "Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "claudeCodeDeck.copyUuid",
        "title": "Copy Claude Code Session ID",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeDeck.newSession",
          "when": "view == claudeCodeDeck.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeDeck.newTripleSession",
          "when": "view == claudeCodeDeck.sessions",
          "group": "navigation@2"
        },
        {
          "command": "claudeCodeDeck.refresh",
          "when": "view == claudeCodeDeck.sessions",
          "group": "navigation@3"
        },
        {
          "command": "claudeCodeDeck.reopenSession",
          "when": "view == claudeCodeDeck.sessions",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeCodeDeck.openSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdSession",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeDeck.openSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdTripleSession",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeDeck.renameSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdSession",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeDeck.renameSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdTripleSession",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeDeck.forkSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdSession",
          "group": "navigation@2"
        },
        {
          "command": "claudeCodeDeck.copyUuid",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdSession",
          "group": "navigation@3"
        },
        {
          "command": "claudeCodeDeck.closeSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdSession",
          "group": "navigation@8"
        },
        {
          "command": "claudeCodeDeck.closeSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdTripleSession",
          "group": "navigation@8"
        },
        {
          "command": "claudeCodeDeck.deleteSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdSession",
          "group": "navigation@9"
        },
        {
          "command": "claudeCodeDeck.deleteSession",
          "when": "view == claudeCodeDeck.sessions && viewItem == ccdTripleSession",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.86.0",
    "typescript": "^5.3.3"
  }
}
